#!/usr/bin/env bash
# lab-runner - Big Data Analytics Lab Runner (launcher window)
#
#   ./lab-runner            interactive menu
#   ./lab-runner 5          run Lab 5 directly (also 4a, 4b, all, diag, setup)
#   ./lab-runner --here 5   same, but in this window instead of a new one
#
# Each lab opens in its own terminal window. This window shows the menu,
# live progress lines, and "Lab N done" / "Lab N failed" at the end.
# Exit code with an argument: 0 when every lab that ran passed, 1 otherwise.

RUNNER_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
. "$RUNNER_DIR/core/common.sh"
case "${1:-}" in --here|-i|--inline) LAB_NEW_WINDOW=0; shift ;; esac
sanitize_env
. "$RUNNER_DIR/core/terminal.sh"
. "$RUNNER_DIR/core/detect.sh"

chmod +x "$RUNNER_DIR/lab-runner" "$CORE_DIR"/*.sh "$CORE_DIR"/diag/run.sh \
         "$LABS_DIR"/*/run.sh "$LABS_DIR"/lab04/*/run.sh 2>/dev/null

mark() { [ "$1" = 1 ] && printf '%s[✓]%s' "$C_GREEN" "$C_RESET" || printf '[ ]'; }

show_menu() {
  clear
  echo "$LINE"
  echo "        BIG DATA ANALYTICS - LAB RUNNER"
  echo "$LINE"
  echo
  echo "Environment status:"
  printf '  %s Java\n'               "$(mark "$ENV_JAVA")"
  printf '  %s Python\n'             "$(mark "$ENV_PYTHON")"
  printf '  %s Hadoop\n'             "$(mark "$ENV_HADOOP")"
  printf '  %s HDFS configuration\n' "$(mark "$ENV_HDFSCONF")"
  printf '  %s Pig\n'                "$(mark "$ENV_PIG")"
  printf '  %s Hive\n'               "$(mark "$ENV_HIVE")"
  printf '  %s Spark\n'              "$(mark "$ENV_SPARK")"
  printf '  %s Kafka\n'              "$(mark "$ENV_KAFKA")"
  if [ -n "$(missing_software)" ]; then
    echo
    echo "  [ ] = not set up yet. Nothing to do: a lab sets up what it needs"
    echo "        the first time you choose it (only that, not everything)."
  fi
  echo
  echo "$LINE2"
  echo "Select a Lab"
  echo "$LINE2"
  echo
  local id
  for id in "${LAB_IDS[@]}"; do
    printf '  %3s. %s\n' "$(menu_key "$id")" "$(lab_title_for "$id")"
  done
  echo
  echo "    A. Run All Labs"
  echo "    S. Set up everything now (the tools of all labs)"
  echo "    D. System Diagnostics"
  echo "    L. View a lab log"
  echo "    R. Rescan environment"
  echo "   0. Exit"
  echo
}

# ---- run one lab in a new window and follow its progress -------------------
wait_for_lab() {
  local id=$1
  local pf="$STATE_DIR/lab$id.progress" sf="$STATE_DIR/lab$id.status" pidf="$STATE_DIR/lab$id.pid"
  local shown=0 total pid started=0 ticks=0
  while :; do
    if [ -f "$pf" ]; then
      total=$(wc -l < "$pf")
      if [ "$total" -gt "$shown" ]; then
        sed -n "$((shown + 1)),${total}p" "$pf" | sed 's/^/    /'
        shown=$total
      fi
    fi
    [ -f "$sf" ] && break
    if [ -f "$pidf" ]; then
      started=1
      pid=$(cat "$pidf" 2>/dev/null)
      if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
        sleep 1
        [ -f "$sf" ] && break
        echo "    [✗] The lab window closed before the lab finished."
        break
      fi
    elif [ "$started" = 0 ]; then
      # the window never started: the emulator exited with an error, or 20 s passed
      if [ -n "${SPAWN_PID:-}" ] && ! kill -0 "$SPAWN_PID" 2>/dev/null; then
        wait "$SPAWN_PID" 2>/dev/null || return 2
        SPAWN_PID=""
      fi
      [ "$ticks" -gt 40 ] && return 2
    fi
    sleep 0.5
    ticks=$((ticks + 1))
  done
}

run_lab() {
  local id=$1 arg=${2:-} auto=${3:-} title name st t0 t1 inline=0
  title=$(lab_title_for "$id"); name=$(lab_short_name "$id")
  rm -f "$STATE_DIR/lab$id.progress" "$STATE_DIR/lab$id.status" "$STATE_DIR/lab$id.pid"
  : > "$STATE_DIR/lab$id.progress"
  echo
  echo "$LINE2"
  echo "${C_BOLD}$title${C_RESET}"
  t0=$(date +%s)
  if [ "${LAB_NEW_WINDOW:-1}" != 1 ]; then
    inline=1
  elif spawn_terminal "$title" "$CORE_DIR/labshell.sh" "$id" "$arg" "$auto"; then
    info "Opened a new terminal window. Watch the commands there."
    echo "    Progress:"
    wait_for_lab "$id"
    if [ $? -eq 2 ]; then
      warn "The lab window did not open ($TERM_EMULATOR). Running the lab in this window instead."
      inline=1
    fi
  else
    warn "No graphical terminal found. Running the lab in this window."
    inline=1
  fi
  [ "$inline" = 1 ] && LAB_INLINE=1 bash "$CORE_DIR/labshell.sh" "$id" "$arg" "$auto"
  t1=$(date +%s)
  st=$(cat "$STATE_DIR/lab$id.status" 2>/dev/null)
  if [ "$st" = OK ]; then
    echo "${C_GREEN}${C_BOLD}[✓] $name done${C_RESET}  ($((t1 - t0))s)"
  else
    st=FAIL
    ANY_FAILED=1
    echo "${C_RED}${C_BOLD}[✗] $name failed${C_RESET}  ($((t1 - t0))s)"
    show_failure "$id"
  fi
  LAST_STATUS=$st
  LAST_SECONDS=$((t1 - t0))
}

# show_failure ID : why the lab failed, without opening the log
show_failure() {
  local f="$LOG_DIR/lab$1.log"
  [ -f "$f" ] || { echo "    No log was written: the lab did not start."; return 0; }
  local why; why=$(grep -E '^\[FAIL\]' "$f" | grep -v 'failed\. Log:' | tail -n 4 | sed 's/^\[FAIL\] /      - /')
  echo "    What went wrong:"
  echo "${why:-      - no error line was recorded, the last lines of the log are:
$(tail -n 6 "$f" | sed 's/^/        /')}"
  echo "    Full log: $(readlink -f "$f")"
}

run_all() {
  local id summary="" ans line out="$RESULTS_DIR/last_run_summary.txt" nfail=0 npass=0
  for id in "${LAB_IDS[@]}"; do
    run_lab_healed "$id"
    line=$(printf '  %-8s %-5s %4ss' "$(lab_short_name "$id")" "$LAST_STATUS" "$LAST_SECONDS")
    summary="$summary$line"$'\n'
    if [ "$LAST_STATUS" = OK ]; then
      npass=$((npass + 1))
    else
      nfail=$((nfail + 1))
    fi
  done
  {
    echo "$LINE"; echo " RUN ALL - SUMMARY   ($(date '+%Y-%m-%d %H:%M'))"; echo "$LINE"
    printf '%s' "$summary"
    echo "$LINE2"
    echo "  $npass passed, $nfail failed"
  } | tee "$out"
  echo "  (saved in $out)"
  [ "$nfail" -eq 0 ]
}

view_log() {
  local ans id f
  read -rp "Lab number (1, 2, 3, 4a, 4b, 5 ... 10) or diag: " ans
  id=$(menu_to_id "$ans"); [ -n "$id" ] || id=$ans
  id=${id%% *}
  f="$LOG_DIR/lab$id.log"
  if [ -f "$f" ]; then
    if have less; then less -R "$f"; else cat "$f"; fi
  else
    warn "No log for lab $id yet"
  fi
}

# menu_key ID : what the user types for a lab ("5" for 05, "4a" for 04a)
menu_key() { echo "$1" | sed -E 's/^0//'; }
# menu_to_id INPUT : lab id for what the user typed (empty if not a lab). "4" means 4a+4b.
menu_to_id() {
  case "$(echo "$1" | tr 'A-Z' 'a-z')" in
    1|01)   echo 01;;  2|02) echo 02;;  3|03) echo 03;;
    4|04)   echo "04a 04b";;
    4a|04a) echo 04a;; 4b|04b) echo 04b;;
    5|05)   echo 05;;  6|06) echo 06;;  7|07) echo 07;;  8|08) echo 08;;  9|09) echo 09;;
    10)     echo 10;;
    diag)   echo diag;;
    setup|s|install) echo setup;;
    *)      echo "";;
  esac
}

# missing_software : names of the tools the scan did not find
missing_software() {
  local m=""
  [ "$ENV_JAVA" = 1 ]   || m="$m java"
  [ "$ENV_HADOOP" = 1 ] || m="$m hadoop"
  [ "$ENV_PIG" = 1 ]    || m="$m pig"
  [ "$ENV_HIVE" = 1 ]   || m="$m hive"
  [ "$ENV_SPARK" = 1 ]  || m="$m spark"
  [ "$ENV_KAFKA" = 1 ]  || m="$m kafka"
  echo "${m# }"
}

# missing_for ID : the parts this lab needs that are not set up on this PC yet
missing_for() {
  local n m=""
  for n in $(lab_needs "$1"); do
    case "$n" in
      java)    [ "$ENV_JAVA" = 1 ]   || m="$m java" ;;
      hadoop)  [ "$ENV_HADOOP" = 1 ] || m="$m hadoop" ;;
      pig)     [ "$ENV_PIG" = 1 ]    || m="$m pig" ;;
      hive)    [ "$ENV_HIVE" = 1 ]   || m="$m hive" ;;
      spark)   [ "$ENV_SPARK" = 1 ]  || m="$m spark" ;;
      kafka)   [ "$ENV_KAFKA" = 1 ]  || m="$m kafka" ;;
      py)      python3 -c "import numpy, pandas, matplotlib, seaborn" >/dev/null 2>&1 || m="$m python-packages" ;;
      pykafka) python3 -c "import kafka" >/dev/null 2>&1 || m="$m kafka-python" ;;
    esac
  done
  echo "${m# }"
}

# ensure_lab_software ID : set up what THIS lab needs and nothing else. What is
# already on the PC is tested and used; only what is missing is downloaded.
ensure_lab_software() {
  local id=$1 miss
  miss=$(missing_for "$id")
  [ -n "$miss" ] || return 0
  [ "${AUTO_SETUP:-1}" = 1 ] || { warn "Not set up: $miss (AUTO_SETUP=0, type S to set up)"; return 0; }
  echo
  info "$(lab_short_name "$id") needs: $(lab_needs "$id"). Not set up on this PC yet: $miss"
  run_lab setup "$(lab_needs "$id")" auto
  rescan_quiet
  miss=$(missing_for "$id")
  [ -z "$miss" ] && return 0
  echo "${C_RED}${C_BOLD}[✗] $(lab_short_name "$id") cannot run: $miss could not be set up (see the Setup lines above)${C_RESET}"
  LAST_STATUS=FAIL; LAST_SECONDS=0; ANY_FAILED=1
  return 1
}

run_selection() {   # run_selection "04a 04b"
  local id
  for id in $1; do run_lab_healed "$id"; done
}

# run_lab_healed ID : set up what the lab needs, run it, and if it failed
# because a tool stopped working (the lab then forgets that copy), set that
# up again and run the lab once more.
run_lab_healed() {
  local before=${ANY_FAILED:-0}
  ensure_lab_software "$1" || return 0
  run_lab "$1"
  [ "$LAST_STATUS" = OK ] && return 0
  rescan_quiet
  [ -n "$(missing_for "$1")" ] || return 0
  warn "A tool the lab needs does not work: $(missing_for "$1"). Setting it up again, then running the lab again."
  run_lab setup "$(lab_needs "$1")" auto
  [ "$LAST_STATUS" = OK ] || return 0
  rescan_quiet
  ANY_FAILED=$before
  run_lab "$1"
}
rescan_quiet() { [ -f "$STATE_DIR/detected.env" ] && . "$STATE_DIR/detected.env"; scan_environment; }

rescan() {
  echo "Scanning the system for installed tools..."
  rm -f "$STATE_DIR/detected.env"
  unset DETECTED_JAVA_HOME DETECTED_HADOOP_HOME DETECTED_PIG_HOME DETECTED_HIVE_HOME DETECTED_SPARK_HOME DETECTED_KAFKA_HOME
  scan_environment
}

# ---- main ------------------------------------------------------------------
usage() {
  echo "Usage: ./lab-runner              interactive menu"
  echo "       ./lab-runner <lab>        run one lab: 1 2 3 4 4a 4b 5 6 7 8 9 10"
  echo "       ./lab-runner all          run every lab in order"
  echo "       ./lab-runner diag         diagnostics report only"
  echo "       ./lab-runner setup        test the tools on this PC, install what is missing"
  echo "       ./lab-runner --here <...> run in this window instead of opening a new one"
}
if [ -n "${1:-}" ]; then
  case "$1" in -h|--help|help) usage; exit 0 ;; esac
  scan_environment
  ANY_FAILED=0
  case "$(echo "$1" | tr 'A-Z' 'a-z')" in
    all|a)  run_all ;;
    diag|d) run_lab diag ;;
    setup|s|install) run_lab setup ;;
    *)      sel=$(menu_to_id "$1"); [ -n "$sel" ] || { echo "Unknown lab: $1"; usage; exit 2; }; run_selection "$sel" ;;
  esac
  [ "$ANY_FAILED" = 0 ]
  exit $?
fi

scan_environment

while :; do
  show_menu
  read -rp "Enter choice: " choice
  case "$(echo "$choice" | tr 'A-Z' 'a-z')" in
    0|q|exit) echo "Bye."; exit 0 ;;
    a|all)    run_all ;;
    d|diag)   run_lab diag ;;
    s|setup)  run_lab setup; rescan_quiet ;;
    l|log)    view_log; continue ;;
    r|rescan) rescan; continue ;;
    *)
      sel=$(menu_to_id "$choice")
      if [ -z "$sel" ]; then echo "Invalid choice. Type a lab number (1 to 10, 4a, 4b), A, D, L, R or 0."; sleep 2; continue; fi
      run_selection "$sel"
      ;;
  esac
  echo
  read -rp "Press ENTER to return to the Lab Runner..." _
  scan_environment
done
